{
  "name": "@happyhackingspace/markdown",
  "description": "Render Markdown to HTML, Happy Hacking Space-style",
  "version": "0.0.1",
  "author": "Lachlan Campbell <lachlan@hackclub.com> (https://lachlanjc.me)",
  "source": "src/index.js",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "sideEffects": false,
  "scripts": {
    "test": "ava",
    "prepare": "rm -rf ./dist && microbundle --external none",
    "watch": "microbundle watch --no-compress --external none",
    "build": "yarn prepare && cd docs && yarn build"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/happyhackingspace/markdown.git"
  },
  "dependencies": {
    "@babel/core": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@mapbox/rehype-prism": "^0.9.0",
    "caniuse-lite": "^1.0.30001282",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.1.5",
    "rehype": "^13.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-remove": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.12.10",
    "ava": "^3.14.0",
    "microbundle": "^0.13.0"
  }
}
